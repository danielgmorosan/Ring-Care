# Obrigada backend — example environment.
# Copy to .env for local dev. NEVER commit a real .env (see .gitignore).
# Secrets in production come from the vault / secret manager, never from files.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Auth. In production JWT_SECRET MUST be a real secret from the vault — the app
# refuses to boot in production with the insecure default.
JWT_SECRET=dev-only-insecure-secret-change-in-prod
JWT_TTL=7d

# Optional. When unset, repositories use in-memory adapters (skeleton mode).
# When set, Postgres/TimescaleDB-backed repositories are used.
# Matches docker-compose (host port 5433 to avoid colliding with a system Postgres).
DATABASE_URL=postgres://obrigada:obrigada@localhost:5433/obrigada

# Optional ephemeral state store (presence, rate limits).
REDIS_URL=redis://localhost:6379

# Device link (F0.3). When set, the backend connects to EMQX over mutual TLS and
# ingests device events/heartbeats. Generate dev certs first: scripts/gen-dev-certs.sh
# Cert paths resolve from the process working directory — pnpm scripts run from
# apps/backend, so point at the repo-root certs/ with ../../ (or use absolute paths).
MQTT_URL=mqtts://localhost:8883
MQTT_CA_PATH=../../certs/backend/ca.crt
MQTT_CERT_PATH=../../certs/backend/tls.crt
MQTT_KEY_PATH=../../certs/backend/tls.key

# Device certificate authority (F2.6). When both are set, provisioning issues each
# guardian phone a per-device client cert (CN = device id) for the mutual-TLS MQTT link,
# signed by this CA (the same CA EMQX trusts). Unset = token-only fallback (HTTP).
DEVICE_CA_CERT_PATH=../../certs/ca/ca.crt
DEVICE_CA_KEY_PATH=../../certs/ca/ca.key

# Seconds without a heartbeat before a device is considered offline.
DEVICE_OFFLINE_THRESHOLD_SECONDS=90

# Escalation engine (F1.4). When set, the backend runs the Temporal worker and
# starts durable escalation workflows. Matches docker-compose's temporal dev server.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=obrigada-escalation

# Synthetic canary (F1.6). Runs a simulated fall through the pipeline on an
# interval; /health/canary reports pipeline health for external alerting.
# Requires Temporal. In Postgres mode, provision the canary family/device first.
CANARY_ENABLED=false
CANARY_INTERVAL_SECONDS=3600
CANARY_FAMILY_ID=00000000-0000-4000-8000-0000000ca000
CANARY_DEVICE_ID=00000000-0000-4000-8000-0000000ca001
