# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Env & secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore

# Dev PKI (generated by scripts/gen-dev-certs.sh). Never commit certs/keys.
/certs/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Firebase app config (API keys) — local only, uploaded to EAS at build
apps/family/google-services.json
apps/family/GoogleService-Info.plist

# Production deploy secrets & certs (server-local, never commit)
deploy/.env
deploy/certs/
