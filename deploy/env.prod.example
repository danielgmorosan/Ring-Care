# Copy to deploy/.env on the server and fill in. NEVER commit the real file.
# deploy/.env is git-ignored.

# The API domain (a DNS A record must point it at this server's IP).
DOMAIN=api.example.com

# A real, long, random JWT signing secret. Generate one, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# The Postgres password (used by the app and by Temporal's persistence).
# Generate one, e.g.:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-to-a-random-password

# Optional: enable cloud narration / Twilio / FCM by adding their keys here, each
# gated on its decision record (0002 / 0003 / 0004). Left unset = safe local mocks.
# ANTHROPIC_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# Optional: live view + voice assistant (F2.5/F3.6), gated on decision record 0010.
# Set all three from your LiveKit project (self-hosted EU or LiveKit Cloud EU region) to
# turn live view on. Left unset = live view/voice are off; the safety core is unaffected.
# LIVEKIT_URL=          # e.g. wss://your-project.livekit.cloud  (or your self-hosted URL)
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Device mutual-TLS certificate authority. When both are set, provisioning issues each
# guardian phone a per-device client certificate (CN = device id) so it can open the
# mutual-TLS MQTT link; EMQX turns the CN into the MQTT username for its per-device ACL.
# Unset = token-only fallback (the phone reports over HTTP until certs are enabled).
# Point these at the CA the broker trusts. The CA key is a secret; keep it off the repo.
# DEVICE_CA_CERT_PATH=/etc/obrigada/ca/ca.crt
# DEVICE_CA_KEY_PATH=/etc/obrigada/ca/ca.key

# Restrict which browser origins may call the API (comma-separated). Unset = any.
# CORS_ORIGINS=https://app.yourdomain.com

# Structured JSON logs for aggregation in production.
LOG_FORMAT=json
